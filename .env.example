# =============================================================================
# f1-decision-platform — environment variable reference
# Copy to .env and fill in real values. NEVER commit the real .env file.
# =============================================================================

# --- n8n ---------------------------------------------------------------
N8N_ENCRYPTION_KEY=
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_JWT_AUTH_ACTIVE=false
N8N_JWT_AUTH_HEADER=
N8N_JWT_AUTH_HEADER_VALUE_PREFIX=

# --- Postgres (decision ledger + n8n storage) --------------------------
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=

# --- Ollama (local model inference) -------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL_AGENT=qwen2.5:14b-instruct
OLLAMA_MODEL_ENRICH=qwen2.5:7b-instruct
OLLAMA_MODEL_JUDGE=qwen2.5:14b-instruct

# --- Kalshi ---------------------------------------------------------------
KALSHI_MODE=fixture  # fixture|live
KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem

# --- Decision policy (guardrails applied before any trade action) ---------
POLICY_MAX_EXPOSURE_USD=1000
POLICY_MIN_CONFIDENCE=0.55
POLICY_MIN_EDGE=0.05
POLICY_MAX_SIZE_USD=100

# --- Observability (Grafana) -----------------------------------------------
# Grafana reads the decision_ledger via the same Postgres creds above.
# Anonymous viewing is on by default; admin login uses these:
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
# Host port for the Grafana UI (change if 3000 is already in use):
GRAFANA_PORT=3000

# --- GCP (deployment target) -----------------------------------------------
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_BILLING_ACCOUNT=
